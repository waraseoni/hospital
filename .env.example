NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backup/restore (scripts/backup.ps1 + restore.ps1) — pooler connection string
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# FHIR interop — optional static token for machine-to-machine /api/fhir/* access.
# Agar empty hai, tab sirf admin/super_admin users access kar sakte hain.
# FHIR_API_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp notifications — FREE: Meta WhatsApp Business Cloud API
# (Twilio hata diya gaya hai — paid service, policy nahi allows)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Appointment reminder cron guard (Vercel Cron calls this route)
# CRON_SECRET=

# Telegram backup notifications (FREE, open protocol — secondary channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# UPI QR Payment (FREE — koi gateway nahi, upi:// intent protocol)
# UPI_ID = hospital ke receive UPI/paytm address, e.g. hospital@upi
UPI_ID=
UPI_PAYEE_NAME=